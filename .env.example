# ==============================================================================
# OmniAgent AI Platform - Environment Configuration Example
# ==============================================================================

# [SERVER-ONLY] Google Gemini API Key
# Injected automatically in Google AI Studio or set manually in Vercel / Cloud Run
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [SERVER-ONLY] Default Gemini Model ID (e.g., gemini-3.8-flash, gemini-3.1-pro-preview)
GEMINI_MODEL="gemini-3.8-flash"

# [PUBLIC] Application Base URL (e.g., https://your-domain.vercel.app)
APP_URL="MY_APP_URL"

# [PUBLIC] Supabase PostgreSQL Instance URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# [PUBLIC] Supabase Anonymous Client Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# [SERVER-ONLY] Supabase Service Role Secret (Required for server-side persistence)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# [SERVER-ONLY] Platform Administrator Email Address
ADMIN_EMAIL="admin@your-domain.example"

# [SERVER-ONLY] Platform Administrator Password (required in production; no default fallback)
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# [SERVER-ONLY] Secret Salt for API Key HMAC Hashing (required in production; no default fallback)
API_KEY_HASH_SECRET="replace-with-a-high-entropy-random-salt"

# [SERVER-ONLY] Emergency/internal admin secret. This is NOT a user login bypass.
# It must never grant isAdmin or a user session by itself.
ADMIN_SECRET="replace-with-a-high-entropy-admin-secret"
